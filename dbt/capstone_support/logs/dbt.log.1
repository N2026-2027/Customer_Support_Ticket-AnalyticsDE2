    create  table
      "support"."main_marts"."fact_tickets__dbt_tmp"
  
    as (
      

with base as (
    select * from "support"."main_marts"."base_fact_tickets"
),

enriched as (
    select
        -- Claves de base
        b.ticket_id,
        b.customer_email,
        b.product,
        b.channel,
        b.category,
        b.priority,
        b.status,
        b.ticket_created_date,
        b.first_response_time_hours,
        b.resolution_time_hours,
        b.customer_satisfaction_score,
        b.dataset_source,

        -- FKs de dimensiones
        c.customer_sk,
        p.product_sk,
        tt.ticket_type_sk,
        b.ticket_created_date as date_id

    from base b
    left join "support"."main_marts"."dim_customer"    c  on b.customer_email = c.customer_email
    left join "support"."main_marts"."dim_product"     p  on b.product        = p.product
                                              and coalesce(b.channel, 'unknown') = p.channel
    left join "support"."main_marts"."dim_ticket_type" tt on b.category       = tt.category
                                              and b.priority       = tt.priority
)

select
    -- Surrogate key de la fact
    md5(cast(coalesce(cast(ticket_id as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(dataset_source as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) as ticket_sk,

    -- Claves foráneas
    ticket_id,
    customer_sk,
    product_sk,
    ticket_type_sk,
    date_id,
    dataset_source,

    -- Atributos del ticket
    status,
    ticket_created_date,

    -- Métricas
    first_response_time_hours,
    resolution_time_hours,
    customer_satisfaction_score,

    -- Campos derivados (calculados correctamente, no hardcoded)
    cast(null as double)   as issue_complexity_score,   -- no existe en dataset original
    cast(null as integer)  as previous_tickets,          -- ídem
    cast(null as boolean)  as escalated,                 -- ídem
    cast(null as boolean)  as sla_breached,              -- ídem
    cast(null as date)     as ticket_resolved_date,      -- ídem

    -- Campos calculados de negocio
    case
        when sla_breached = false then 'SLA_Cumplido'
        when sla_breached = true  then 'SLA_Incumplido'
        else 'SLA_Cumplido'                             -- default seguro cuando es NULL
    end as sla_status,

    case
        when status in ('closed', 'resolved') then true
        else false
    end as is_resolved,

    case
        when customer_satisfaction_score >= 4 then 'satisfied'
        when customer_satisfaction_score >= 3 then 'neutral'
        when customer_satisfaction_score is not null then 'unsatisfied'
        else 'unknown'
    end as satisfaction_band

from enriched
    );
  
  
