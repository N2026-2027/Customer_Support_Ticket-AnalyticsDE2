    create  table
      "support"."main_marts"."dim_product__dbt_tmp"
  
    as (
      

WITH base AS (
    SELECT DISTINCT
        product,
        -- Usamos el nombre real que viene del staging: ticket_channel
        COALESCE(ticket_channel, 'unknown') as channel_name
    FROM "support"."main_staging"."stg_tickets_200k"
)

SELECT
    md5(cast(coalesce(cast(product as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(channel_name as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS product_sk,
    product,
    channel_name as channel
FROM base
    );
  
  
[0m13:49:56.823895 [debug] [Thread-2 (]: SQL status: OK in 0.002 seconds
[0m13:49:56.825610 [debug] [Thread-2 (]: Using duckdb connection "model.customer_support_tickets.dim_customer"
[0m13:49:56.826151 [debug] [Thread-2 (]: On model.customer_support_tickets.dim_customer: /* {"app": "dbt", "dbt_version": "1.11.8", "profile_name": "customer_support_tickets", "target_name": "dev", "node_id": "model.customer_support_tickets.dim_customer"} */

  
    
    

    create  table
      "support"."main_marts"."dim_customer__dbt_tmp"
  
    as (
      -- models/marts/dim_customer.sql
-- Dimensión de clientes simplificada según columnas disponibles en staging



WITH ranked AS (
    SELECT
        customer_email,
        customer_name,
        customer_age,
        customer_gender,
        dataset_source,
        -- Como no tenemos 'customer_tenure_months', usamos ingested_at o email para el rank
        ROW_NUMBER() OVER (
            PARTITION BY customer_email
            ORDER BY _ingested_at DESC
        ) AS rn
    FROM "support"."main_staging"."stg_tickets_200k"
)

SELECT
    md5(cast(coalesce(cast(customer_email as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT))   AS customer_sk,
    customer_email,
    customer_name,
    customer_age,
    CASE
        WHEN customer_age < 25 THEN 'Gen Z'
        WHEN customer_age < 40 THEN 'Millennial'
        WHEN customer_age < 55 THEN 'Gen X'
        ELSE 'Boomer+'
    END                                                          AS age_cohort,
    customer_gender,
    -- Ponemos como 'unknown' lo que no viene del staging para no romper el modelo
    'unknown'                                                    AS subscription_type,
    'unknown'                                                    AS customer_segment,
    'unknown'                                                    AS region,
    dataset_source

FROM ranked
