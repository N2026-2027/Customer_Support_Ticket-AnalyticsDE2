    create  table
      "support_200k"."main"."base_fact_tickets__dbt_tmp"
  
    as (
      

-- CTE 1: Importación de datos crudos
WITH staging_data AS (
    SELECT * FROM "support_200k"."main"."stg_tickets_200k"
),

-- CTE 2: Limpieza, Casteo y Manejo de Nulos (Capa de Integridad)
cleaned_data AS (
    SELECT
        -- Identificadores (Garantizamos que no sean nulos para evitar fallos en JOINs)
        COALESCE(CAST(ticket_id AS VARCHAR), 'N/A')       AS ticket_id,
        COALESCE(CAST(customer_id AS VARCHAR), 'N/A')     AS customer_id,
        LOWER(TRIM(CAST(customer_email AS VARCHAR)))      AS customer_email,

        -- Dimensiones (Limpieza de espacios y normalización de texto)
        LOWER(TRIM(CAST(ticket_channel AS VARCHAR)))      AS ticket_channel,
        LOWER(TRIM(CAST(ticket_type AS VARCHAR)))         AS ticket_type,
        COALESCE(CAST(ticket_subject AS VARCHAR), '(sin asunto)') AS ticket_subject,
        LOWER(TRIM(CAST(ticket_priority AS VARCHAR)))     AS ticket_priority,
        LOWER(TRIM(CAST(ticket_status AS VARCHAR)))       AS ticket_status,

        -- Cliente y Producto (Validación de rangos)
        COALESCE(CAST(customer_age AS INTEGER), 0)        AS customer_age,
        LOWER(TRIM(CAST(product_purchased AS VARCHAR)))   AS product_name,

        -- Fechas (Aseguramos formato correcto)
        CAST(ticket_created_date AS TIMESTAMP)            AS ticket_created_at,
        CAST(purchase_date AS DATE)                       AS purchase_at_date,
        
        -- Métricas (Evitamos que un NULL rompa un promedio/AVG posterior)
        COALESCE(CAST(first_response_time_hours AS DOUBLE), 0.0) AS first_response_time_hours,
        COALESCE(CAST(resolution_time_hours AS DOUBLE), 0.0)     AS resolution_time_hours,
        COALESCE(CAST(satisfaction_rating AS INTEGER), 0)        AS satisfaction_rating
    FROM staging_data
),

-- CTE 3: Capa de Lógica de Negocio (Campos calculados para blindar los Marts)
business_logic AS (
    SELECT
        *,
        -- Banderas de cumplimiento (Evita que el Mart tenga que calcular lógica compleja)
        CASE WHEN first_response_time_hours <= 24 THEN 1 ELSE 0 END AS is_within_sla_first_response,
        CASE WHEN resolution_time_hours <= 72 THEN 1 ELSE 0 END     AS is_within_sla_resolution,
        
        -- Segmentación básica de edad (Para ayudar a mart_cx_satisfaction)
        CASE 
            WHEN customer_age < 25 THEN 'Gen Z'
            WHEN customer_age BETWEEN 25 AND 40 THEN 'Millennial'
            WHEN customer_age > 40 THEN 'Gen X/Boomer'
            ELSE 'Unknown'
        END AS age_segment,

        -- Alias de compatibilidad total
        ticket_channel                                    AS channel,
        ticket_type                                       AS category,
        ticket_priority                                   AS priority,
        ticket_status                                     AS status,
        product_name                                      AS product,
        product_name                                      AS product_purchased,
        ticket_created_at                                 AS ticket_created_date,
        purchase_at_date                                  AS purchase_date,
        satisfaction_rating                               AS customer_satisfaction_score,
        
        -- Metadatos
        '200k'                                            AS dataset_source,
        CURRENT_TIMESTAMP                                 AS _ingested_at
    FROM cleaned_data
),

-- CTE 4: Deduplicación (Por si la fuente trae el mismo ticket dos veces)
final_deduplicated AS (
    SELECT 
        *,
        ROW_NUMBER() OVER (PARTITION BY ticket_id ORDER BY ticket_created_at DESC) AS row_num
    FROM business_logic
)

-- Selección Final (Filtramos duplicados y exponemos todo)
SELECT
    ticket_id,
    customer_id,
    customer_email,
    customer_age,
    age_segment,
    ticket_channel,
    channel,
    ticket_type,
    category,
    ticket_subject,
    ticket_priority,
    priority,
    ticket_status,
    status,
    product_name,
    product,
    product_purchased,
    ticket_created_at,
    ticket_created_date,
    purchase_at_date,
    purchase_date,
    first_response_time_hours,
    is_within_sla_first_response,
    resolution_time_hours,
    is_within_sla_resolution,
    satisfaction_rating,
    customer_satisfaction_score,
    dataset_source,
    _ingested_at
FROM final_deduplicated
WHERE row_num = 1 -- Solo nos quedamos con el registro más reciente de cada ticket
    );
  
  
