  create view "support"."main_staging"."stg_tickets_200k__dbt_tmp" as (
    

with raw_data as (
    select 
        *,
        -- Mapeo de nombres basado en los Candidate Bindings del log
        "Product Purchased" as raw_product,
        "Ticket Type" as raw_category,
        "Ticket Status" as raw_status,
        "Ticket Priority" as raw_priority,
        "Ticket Channel" as raw_channel,
        "Customer Satisfaction Rating" as raw_rating,
        -- Ajuste: Quitamos el sufijo 'Hours' que no existe en la fuente
        "First Response Time" as raw_frt,
        "Time to Resolution" as raw_ttr
    from "support"."raw"."customer_support_tickets"
)

select
    cast("Ticket ID" as varchar) as ticket_id,
    md5(cast(coalesce(cast("Customer Name" as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast("Customer Email" as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) as customer_id,
    lower(trim("Customer Name")) as customer_name,
    lower(trim("Customer Email")) as customer_email,
    lower(trim("Customer Gender")) as customer_gender,
    cast("Customer Age" as integer) as customer_age,
    
    -- Dimensiones
    lower(trim(raw_product)) as product,
    lower(trim(raw_product)) as product_purchased,
    lower(trim(raw_category)) as category,
    lower(trim(raw_category)) as ticket_type,
    lower(trim(raw_status)) as status,
    lower(trim(raw_status)) as ticket_status,
    lower(trim(raw_priority)) as priority,
    lower(trim(raw_priority)) as ticket_priority,
    lower(trim(raw_channel)) as ticket_channel,
    
    -- Métricas (Usando Rating en lugar de Score)
    cast(raw_rating as double) as satisfaction_rating,
    cast(raw_rating as double) as customer_satisfaction_score,
    
    -- Tiempos (Usando los nombres reales detectados en el log)
    cast(raw_frt as double) as first_response_hrs,
    cast(raw_frt as double) as first_response_time_hours,
    cast(raw_ttr as double) as resolution_hrs,
    cast(raw_ttr as double) as resolution_time_hours,
    
    -- Fechas
    cast("Ticket Created Date" as date) as ticket_created_date,
    cast("Ticket Created Date" as date) as purchase_date,
    
    '200k' as dataset_source,
    _ingested_at

from raw_data
  );

