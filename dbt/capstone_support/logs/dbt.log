     cross join 
    
    p as p11
    
    

    )

    select *
    from unioned
    where generated_number <= 2556
    order by generated_number



),

all_periods as (

    select (
        

    (cast('2020-01-01' as date) + cast(row_number() over (order by generated_number) - 1 as bigint) * interval 1 day)
    ) as date_day
    from rawdata

),

filtered as (

    select *
    from all_periods
    where date_day <= cast('2026-12-31' as date)

)

select * from filtered


)

select
