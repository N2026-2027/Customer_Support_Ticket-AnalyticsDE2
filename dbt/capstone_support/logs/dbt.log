[0m22:33:09.196497 [debug] [Thread-4 (]: On model.customer_support_tickets.stg_tickets_original: /* {"app": "dbt", "dbt_version": "1.11.8", "profile_name": "customer_support_tickets", "target_name": "dev", "node_id": "model.customer_support_tickets.stg_tickets_original"} */

  
  create view "support_200k"."main"."stg_tickets_original__dbt_tmp" as (
    SELECT 
    ticket_id,
    customer_name,
    category,
    priority,
    status,
