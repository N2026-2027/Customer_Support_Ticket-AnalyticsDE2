  create view "support"."main_staging"."stg_tickets__dbt_tmp" as (
    

with raw_source as (
    select * from "support"."main_raw"."customer_support_tickets"
)

select
    -- IDs y Claves
    md5(cast(coalesce(cast(raw_source."Customer Name" as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(raw_source."Customer Email" as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) as customer_id,
    cast(raw_source."Ticket ID" as varchar) as ticket_id,
    
    -- Información de Cliente
    lower(trim(raw_source."Customer Name")) as customer_name,
    lower(trim(raw_source."Customer Email")) as customer_email,
    lower(trim(raw_source."Customer Gender")) as customer_gender,
    cast(raw_source."Customer Age" as integer) as customer_age,
    
    -- Dimensiones y sus Alias para Marts
    lower(trim(raw_source."Product Purchased")) as product,
    lower(trim(raw_source."Product Purchased")) as product_purchased,
    lower(trim(raw_source."Ticket Type")) as category,
    lower(trim(raw_source."Ticket Type")) as ticket_type,
    lower(trim(raw_source."Ticket Subject")) as ticket_subject,
    lower(trim(raw_source."Ticket Priority")) as priority,
    lower(trim(raw_source."Ticket Priority")) as ticket_priority,
    lower(trim(raw_source."Ticket Status")) as status,
    lower(trim(raw_source."Ticket Status")) as ticket_status,
    lower(trim(raw_source."Ticket Channel")) as ticket_channel,
    
    -- Tiempos y Fechas
    cast(raw_source."Date of Purchase" as date) as ticket_created_date,
    cast(raw_source."Date of Purchase" as date) as purchase_date,
    epoch(cast(raw_source."First Response Time" as timestamp)) / 3600.0 as first_response_hrs,
    epoch(cast(raw_source."First Response Time" as timestamp)) / 3600.0 as first_response_time_hours,
    epoch(cast(raw_source."Time to Resolution" as timestamp)) / 3600.0 as resolution_hrs,
    epoch(cast(raw_source."Time to Resolution" as timestamp)) / 3600.0 as resolution_time_hours,
    
    -- KPIs y Ratings
    cast(raw_source."Customer Satisfaction Rating" as double) as satisfaction_rating,
    cast(raw_source."Customer Satisfaction Rating" as double) as customer_satisfaction_score,
    (lower(trim(raw_source."Ticket Status")) = 'open' and raw_source."First Response Time" is null) as is_open_no_response,
    (lower(trim(raw_source."Ticket Status")) != 'resolved') as is_unresolved,
    
    'original' as dataset_source,
    -- CAMBIO AQUÍ: Generamos la fecha de ingesta actual ya que el CSV no la trae
    current_timestamp as _ingested_at

from raw_source
  );

[0m16:02:24.666717 [debug] [Thread-1 (]: On model.customer_support_tickets.dim_date: /* {"app": "dbt", "dbt_version": "1.11.8", "profile_name": "customer_support_tickets", "target_name": "dev", "node_id": "model.customer_support_tickets.dim_date"} */

  
    
    

    create  table
      "support"."main_marts"."dim_date__dbt_tmp"
  
    as (
      

WITH date_series AS (
    SELECT CAST(range AS DATE) AS date_day
    FROM range(DATE '2020-01-01', DATE '2026-12-31', INTERVAL 1 DAY)
)

SELECT
    date_day AS date_id,
    EXTRACT(YEAR FROM date_day) AS year,
    EXTRACT(MONTH FROM date_day) AS month,
    EXTRACT(QUARTER FROM date_day) AS quarter,
    -- strftime es el equivalente a FORMAT_DATE en DuckDB
    strftime(date_day, '%B') AS month_name,
    CASE WHEN EXTRACT(DOW FROM date_day) IN (0, 6) THEN TRUE ELSE FALSE END AS is_weekend
FROM date_series
    );
  
  
[0m16:02:24.667190 [debug] [Thread-3 (]: On model.customer_support_tickets.stg_tickets_200k: /* {"app": "dbt", "dbt_version": "1.11.8", "profile_name": "customer_support_tickets", "target_name": "dev", "node_id": "model.customer_support_tickets.stg_tickets_200k"} */

  
  create view "support"."main_staging"."stg_tickets_200k__dbt_tmp" as (
    

with source as (

    select *
    from "support"."main_raw"."customer_support_tickets"

),

renamed as (

    select
        -- IDs
        cast("Ticket ID" as varchar) as ticket_id,

        md5(cast(coalesce(cast("Customer Name" as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast("Customer Email" as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) as customer_id,

        -- Customer
        nullif(lower(trim("Customer Name")), '') as customer_name,
        nullif(lower(trim("Customer Email")), '') as customer_email,
        nullif(lower(trim("Customer Gender")), '') as customer_gender,
        try_cast("Customer Age" as integer) as customer_age,

        -- Dimensiones (normalizadas)
        nullif(lower(trim("Product Purchased")), '') as product,
        -- Agregamos estos alias que los Marts van a pedir después
        nullif(lower(trim("Product Purchased")), '') as product_purchased, 
        nullif(lower(trim("Ticket Type")), '') as ticket_type,
        nullif(lower(trim("Ticket Type")), '') as category,
        nullif(lower(trim("Ticket Status")), '') as ticket_status,
        nullif(lower(trim("Ticket Status")), '') as status,
        nullif(lower(trim("Ticket Priority")), '') as ticket_priority,
        nullif(lower(trim("Ticket Priority")), '') as priority,
        nullif(lower(trim("Ticket Channel")), '') as ticket_channel,
        "Ticket Subject" as ticket_subject,

        -- Métricas
        try_cast("Customer Satisfaction Rating" as double) as satisfaction_rating,
        try_cast("Customer Satisfaction Rating" as double) as customer_satisfaction_score,

        -- Tiempos
        try_cast("First Response Time" as double) as first_response_hours,
        try_cast("First Response Time" as double) as first_response_time_hours,
        try_cast("Time to Resolution" as double) as resolution_time_hours,

        -- Fechas
        try_cast("Date of Purchase" as date) as ticket_created_date,
        try_cast("Date of Purchase" as date) as purchase_date,

        -- Metadata (GENERADA A MANO porque el seed no la trae)
        current_timestamp as _ingested_at,
        '200k' as dataset_source

    from source

),

deduplicated as (

    select *
    from (
        select *,
            row_number() over (
                partition by ticket_id
                order by _ingested_at desc
            ) as rn
        from renamed
    )
    where rn = 1

)

select * from deduplicated
  );

