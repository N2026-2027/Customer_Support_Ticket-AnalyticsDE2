      -- models/marts/fact_tickets.sql
-- Tabla de hechos central del Star Schema
-- Granularidad: 1 fila = 1 ticket



WITH base AS (
    -- 200k dataset (datos ricos)
    SELECT
        ticket_id,
        customer_email,
        product,
        channel,
        category,
        priority,
        status,
        ticket_created_date,
        ticket_resolved_date,
        first_response_time_hours,
        resolution_time_hours,
        customer_satisfaction_score,
        issue_complexity_score,
        escalated,
        sla_breached,
        previous_tickets,
        dataset_source
    FROM "support"."main_staging"."stg_tickets_200k"

    UNION ALL

    -- Dataset original (columnas faltantes → NULL)
    SELECT
        ticket_id,
        customer_email,
        product,
        channel,
        category,
        priority,
        status,
        ticket_created_date,
        ticket_resolved_date,
        first_response_time_hours,
        resolution_time_hours,
        customer_satisfaction_score,
        issue_complexity_score,
        escalated,
        sla_breached,
        previous_tickets,
        dataset_source
    -- CAMBIO AQUÍ: Usamos 'stg_tickets' que es tu archivo existente
    FROM "support"."main_staging"."stg_tickets" 
),

enriched AS (
    SELECT
        b.*,
        c.customer_sk,
        p.product_sk,
        tt.ticket_type_sk,
        b.ticket_created_date AS date_id
    FROM base b
    LEFT JOIN "support"."main_marts"."dim_customer"    c  ON b.customer_email = c.customer_email
    LEFT JOIN "support"."main_marts"."dim_product"     p  ON b.product = p.product
                                              AND COALESCE(b.channel, 'unknown') = p.channel
    LEFT JOIN "support"."main_marts"."dim_ticket_type" tt ON b.category = tt.category
                                              AND b.priority  = tt.priority
)

SELECT
    -- Surrogate key de la fact
    md5(cast(coalesce(cast(ticket_id as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(dataset_source as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS ticket_sk,

    -- Claves foráneas (FK → dimensiones)
    ticket_id,
    customer_sk,
    product_sk,
    ticket_type_sk,
    date_id,                              -- FK → dim_date.date_id
    dataset_source,

    -- Status del ticket
    status,

    -- Métricas (measures)
    first_response_time_hours,
    resolution_time_hours,
    customer_satisfaction_score,
    issue_complexity_score,
    previous_tickets,

    -- Flags / booleanos
    escalated,
    sla_breached,
    CASE
        WHEN sla_breached = FALSE THEN 'SLA_Cumplido'
        ELSE 'SLA_Incumplido'
    END                                   AS sla_status,

    -- Métricas derivadas
    CASE
        WHEN resolution_time_hours IS NOT NULL AND ticket_resolved_date IS NOT NULL
        THEN TRUE ELSE FALSE
    END                                   AS is_resolved,

    CASE
        WHEN customer_satisfaction_score >= 4 THEN 'satisfied'
        WHEN customer_satisfaction_score >= 3 THEN 'neutral'
        WHEN customer_satisfaction_score IS NOT NULL THEN 'unsatisfied'
        ELSE 'unknown'
    END                                   AS satisfaction_band,

    ticket_resolved_date

FROM enriched
WITH base AS (
    SELECT ... FROM "support"."main_staging"."stg_tickets_200k"
    UNION ALL
    SELECT ... FROM "support"."main_staging"."stg_tickets"
)
    );
  
  
