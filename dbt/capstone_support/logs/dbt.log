[0m21:02:12.023410 [debug] [Thread-4 (]: On model.customer_support_tickets.mart_channel_efficiency: /* {"app": "dbt", "dbt_version": "1.11.8", "profile_name": "customer_support_tickets", "target_name": "dev", "node_id": "model.customer_support_tickets.mart_channel_efficiency"} */

  
    
    

    create  table
      "support_200k"."main"."mart_channel_efficiency__dbt_tmp"
  
    as (
      

with base as (
    -- CAMBIO: Ahora lee del staging de 200k que es el que existe
    select * from "support_200k"."main"."stg_tickets_200k"
),

-- Global benchmarks para comparar
global_bench as (
    select
        count(*)                                                as g_total,
        avg(satisfaction_rating)                               as g_avg_sat,
        -- Ajuste de nombres de columna para que coincidan con stg_tickets_200k
        round(100.0 * sum(case when ticket_status in ('closed', 'resolved') then 1 else 0 end)
              / count(*), 1)                                   as g_pct_closed,
        -- Si no tenés 'is_open_no_response', lo calculamos como los que no tienen respuesta
        round(100.0 * sum(case when first_response_time_hours is null then 1 else 0 end)
              / count(*), 1)                                   as g_pct_no_response
    from base
),

channel_metrics as (
    select
        b.ticket_channel,
        b.ticket_type,
        b.ticket_priority,

        count(*)                                                as total_tickets,

        -- Volumen relativo
        round(100.0 * count(*) / max(g.g_total), 1)            as pct_of_all_tickets,

        -- Resolución
        sum(case when b.ticket_status in ('closed', 'resolved') then 1 else 0 end)  as resolved_count,
        round(100.0 * sum(case when b.ticket_status in ('closed', 'resolved') then 1 else 0 end)
              / count(*), 1)                                   as pct_resolved,

        -- Tickets sin respuesta aún
        sum(case when b.first_response_time_hours is null then 1 else 0 end) as no_response_count,
        round(100.0 * sum(case when b.first_response_time_hours is null then 1 else 0 end)
              / count(*), 1)                                   as pct_no_response,

        -- Satisfacción
        avg(b.satisfaction_rating)                             as avg_satisfaction,

        -- Críticos sin resolver
        sum(case when b.ticket_priority in ('critical', 'urgent')
                  and b.ticket_status not in ('closed', 'resolved') then 1 else 0 end) as critical_open,

        -- Comparación vs benchmark global
        round(
            (100.0 * sum(case when b.ticket_status in ('closed', 'resolved') then 1 else 0 end) / count(*))
            - max(g.g_pct_closed)
        , 1)                                                   as resolution_vs_global,

        round(
            coalesce(avg(b.satisfaction_rating), 3) - max(g.g_avg_sat)
        , 2)                                                   as satisfaction_vs_global,

        -- Eficiencia compuesta
        case
            when round(100.0 * sum(case when b.ticket_status in ('closed', 'resolved') then 1 else 0 end)
                       / count(*), 1) > max(g.g_pct_closed)
             and coalesce(avg(b.satisfaction_rating),3) > max(g.g_avg_sat)
                then '⭐ Mejor que promedio'
            when round(100.0 * sum(case when b.ticket_status in ('closed', 'resolved') then 1 else 0 end)
                       / count(*), 1) < max(g.g_pct_closed)
             and coalesce(avg(b.satisfaction_rating),3) < max(g.g_avg_sat)
                then '⚠️ Peor que promedio'
            else '➡️ Promedio'
        end                                                    as channel_rating

    from base b
    cross join global_bench g
    group by 1,2,3
)

select * from channel_metrics
order by ticket_channel, pct_resolved asc
    );
  
  
