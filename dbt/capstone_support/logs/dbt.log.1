[0m16:05:21.140170 [debug] [Thread-1 (]: Using duckdb connection "model.customer_support_tickets.dim_date"
[0m16:05:21.143088 [debug] [Thread-1 (]: On model.customer_support_tickets.dim_date: /* {"app": "dbt", "dbt_version": "1.11.8", "profile_name": "customer_support_tickets", "target_name": "dev", "node_id": "model.customer_support_tickets.dim_date"} */

  
    
    

    create  table
      "support"."main_marts"."dim_date__dbt_tmp"
  
    as (
      

WITH date_series AS (
    SELECT CAST(range AS DATE) AS date_day
    FROM range(DATE '2020-01-01', DATE '2026-12-31', INTERVAL 1 DAY)
)

SELECT
    date_day AS date_id,
    EXTRACT(YEAR FROM date_day) AS year,
    EXTRACT(MONTH FROM date_day) AS month,
    EXTRACT(QUARTER FROM date_day) AS quarter,
    -- strftime es el equivalente a FORMAT_DATE en DuckDB
    strftime(date_day, '%B') AS month_name,
    CASE WHEN EXTRACT(DOW FROM date_day) IN (0, 6) THEN TRUE ELSE FALSE END AS is_weekend
FROM date_series
    );
  
  
[0m16:05:21.142063 [debug] [Thread-4 (]: SQL status: OK in 0.005 seconds
