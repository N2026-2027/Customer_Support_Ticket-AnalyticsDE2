    lower(trim(raw_source."Category")) as category,
    lower(trim(raw_source."Category")) as ticket_type,
    lower(trim(raw_source."Status")) as status,
    lower(trim(raw_source."Status")) as ticket_status,
    lower(trim(raw_source."Priority")) as priority,
    lower(trim(raw_source."Priority")) as ticket_priority,
    lower(trim(raw_source."Channel")) as ticket_channel,
    
    -- Métricas y Fechas
    cast(raw_source."Customer Satisfaction Score" as double) as satisfaction_rating,
    cast(raw_source."Customer Satisfaction Score" as double) as customer_satisfaction_score,
    cast(raw_source."First Response Time Hours" as double) as first_response_hrs,
    cast(raw_source."First Response Time Hours" as double) as first_response_time_hours,
    cast(raw_source."Resolution Time Hours" as double) as resolution_hrs,
    cast(raw_source."Resolution Time Hours" as double) as resolution_time_hours,
    cast(raw_source."Ticket Created Date" as date) as ticket_created_date,
    cast(raw_source."Ticket Created Date" as date) as purchase_date,
    
    '200k' as dataset_source,
    _ingested_at

from raw_source
  );

