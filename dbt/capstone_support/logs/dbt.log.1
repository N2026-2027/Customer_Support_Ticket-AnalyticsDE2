  create view "support"."main_staging"."stg_tickets__dbt_tmp" as (
    

with source as (
    select * from "support"."main"."customer_support_tickets_200k"
),

cleaned as (
    select
        md5(cast(coalesce(cast("Customer Name" as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast("Customer Email" as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) as customer_id,
        cast("Ticket ID"           as varchar)  as ticket_id,
        lower(trim("Customer Email"))           as customer_email, -- Agregada para la Fact
        lower(trim("Customer Name"))            as customer_name,
        cast("Customer Age"        as integer)  as customer_age,
        lower(trim("Customer Gender"))          as customer_gender,
        lower(trim("Product Purchased"))        as product,          -- Renombrada para match
        cast("Date of Purchase"    as date)     as ticket_created_date, -- Renombrada para match
        cast(null as date)                      as ticket_resolved_date, -- Dummy para Union
        lower(trim("Ticket Type"))              as category,         -- Renombrada para match
        lower(trim("Ticket Subject"))           as ticket_subject,
        lower(trim("Ticket Status"))            as status,           -- Renombrada para match
        lower(trim("Ticket Priority"))          as priority,         -- Renombrada para match
        lower(trim("Ticket Channel"))           as channel,          -- Renombrada para match
        
        -- Cálculo de horas
        epoch(cast("First Response Time" as timestamp)) / 3600.0  as first_response_time_hours, -- Renombrada
        epoch(cast("Time to Resolution"  as timestamp)) / 3600.0  as resolution_time_hours,     -- Renombrada
        
        -- Campos adicionales para la Fact
        cast("Customer Satisfaction Rating" as double) as customer_satisfaction_score, -- Renombrada
        cast(null as integer)                         as issue_complexity_score,      -- Dummy
        cast(null as boolean)                         as escalated,                   -- Dummy
        cast(null as boolean)                         as sla_breached,                -- Dummy
        cast(null as integer)                         as previous_tickets,            -- Dummy
        'original'                                    as dataset_source,              -- Identificador
        
        -- Booleanos para KPIs originales
        (lower(trim("Ticket Status")) = 'open' and "First Response Time" is null) as is_open_no_response,
        (lower(trim("Ticket Status")) != 'resolved') as is_unresolved,
        
        _ingested_at
    from source
)

select * from cleaned
  );

