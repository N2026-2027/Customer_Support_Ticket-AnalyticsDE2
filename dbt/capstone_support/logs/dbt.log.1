  create view "support"."main_staging"."stg_users__dbt_tmp" as (
    

-- stg_users lee del 200k que tiene snake_case nativo.
-- NO usar "Customer Name" con comillas/Title Case.

with source as (
    select * from "support"."main"."customer_support_tickets_200k"
)

select distinct
    md5(cast(coalesce(cast(customer_name as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(customer_email as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT))                               as user_id,
    nullif(lower(trim(customer_name)),  '') as name,
    nullif(lower(trim(customer_email)), '') as email,
    nullif(lower(trim(customer_gender)),'') as gender,
    try_cast(customer_age as integer)       as age,
    nullif(lower(trim(customer_segment)),'') as segment,
    nullif(lower(trim(subscription_type)),'') as subscription_type,
    try_cast(customer_tenure_months as integer) as tenure_months,
    nullif(lower(trim(region)), '')         as region,
    nullif(lower(trim(language)), '')       as language,
    nullif(lower(trim(preferred_contact_time)), '') as preferred_contact_time,
    nullif(lower(trim(payment_method)), '') as payment_method
from source
  );

