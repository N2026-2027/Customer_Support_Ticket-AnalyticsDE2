    create  table
      "support_200k"."main"."mart_channel_efficiency__dbt_tmp"
  
    as (
      

with base as (
    -- Traemos todo lo que el staging pase, aunque sean pocas columnas
    select * from "support_200k"."main"."stg_tickets"
),

-- Si el staging solo pasa ticket_id, el mart solo puede agrupar por lo que tiene.
