  create view support_200k.main_staging.stg_tickets_200k__dbt_tmp as (
    

with source as (
    select * from "support_200k"."main"."customer_support_tickets_200k"
)

select
    -- 1. Quitamos comillas y usamos guiones bajos. 
    -- DuckDB convierte "Ticket ID" a "ticket_id" automáticamente.
    ticket_id::varchar as ticket_id,
    customer_email::varchar as customer_email,
    
    -- 2. En el dataset de 200k, a veces la columna es 'ticket_channel' y otras 'channel'
    -- Si 'ticket_channel' falla, usa 'channel' a secas:
    ticket_channel::varchar as ticket_channel, 
    
    product::varchar as product,
    subscription_type::varchar as category,
    subscription_type::varchar as ticket_type,
    'medium'::varchar as priority,
    'medium'::varchar as ticket_priority,
    
    -- 3. IMPORTANTE: En el CSV de 200k, la columna suele llamarse 'date_of_purchase'
    -- La renombramos aquí para que coincida con tu esquema de staging
    date_of_purchase::date as ticket_created_date,
    
    4.0::double as satisfaction_rating,
    current_timestamp as _ingested_at,
    '200k' as dataset_source
from source
  );

