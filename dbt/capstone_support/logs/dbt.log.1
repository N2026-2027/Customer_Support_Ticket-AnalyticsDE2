    create  table
      "support"."main_marts"."fact_tickets__dbt_tmp"
  
    as (
      

WITH base AS (
    -- Dataset 200k
    SELECT
        CAST(ticket_id AS VARCHAR) AS ticket_id,
        CAST(customer_email AS VARCHAR) AS customer_email,
        CAST(product AS VARCHAR) AS product,
        CAST(ticket_channel AS VARCHAR) AS channel,
        -- CAMBIO AQUÍ: Usamos ticket_type que es el que dbt sí ve
        CAST(ticket_type AS VARCHAR) AS category, 
        CAST(ticket_priority AS VARCHAR) AS priority,
        CAST(ticket_status AS VARCHAR) AS status,
        CAST(ticket_created_date AS DATE) AS ticket_created_date,
        CAST(NULL AS DATE) AS ticket_resolved_date, 
        CAST(first_response_hours AS DOUBLE) AS first_response_time_hours,
        CAST(resolution_time_hours AS DOUBLE) AS resolution_time_hours,
        CAST(satisfaction_rating AS DOUBLE) AS customer_satisfaction_score,
        '200k' AS dataset_source
    FROM "support"."main_staging"."stg_tickets_200k"

    UNION ALL

    -- Dataset original
    SELECT
        CAST(ticket_id AS VARCHAR) AS ticket_id,
        CAST(customer_email AS VARCHAR) AS customer_email,
        CAST(product AS VARCHAR) AS product,
        CAST(ticket_channel AS VARCHAR) AS channel,
        CAST(category AS VARCHAR) AS category,
        CAST(priority AS VARCHAR) AS priority,
        CAST(status AS VARCHAR) AS status,
        CAST(ticket_created_date AS DATE) AS ticket_created_date,
        CAST(NULL AS DATE) AS ticket_resolved_date,
        CAST(first_response_hrs AS DOUBLE) AS first_response_time_hours,
        CAST(resolution_hrs AS DOUBLE) AS resolution_time_hours,
        CAST(satisfaction_rating AS DOUBLE) AS customer_satisfaction_score,
        'original' AS dataset_source
    FROM "support"."main_staging"."stg_tickets" 
),

enriched AS (
    SELECT
        b.*,
        c.customer_sk,
        p.product_sk,
        tt.ticket_type_sk,
        b.ticket_created_date AS date_id
    FROM base b
    LEFT JOIN "support"."main_marts"."dim_customer"    c  ON b.customer_email = c.customer_email
    LEFT JOIN "support"."main_marts"."dim_product"     p  ON b.product = p.product
                                              AND COALESCE(b.channel, 'unknown') = p.channel
    LEFT JOIN "support"."main_marts"."dim_ticket_type" tt ON b.category = tt.category
                                              AND b.priority  = tt.priority
)

SELECT
    md5(cast(coalesce(cast(ticket_id as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(dataset_source as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS ticket_sk,
    ticket_id,
    customer_sk,
    product_sk,
    ticket_type_sk,
    date_id,
    dataset_source,
    status,
    first_response_time_hours,
    resolution_time_hours,
    customer_satisfaction_score,
    ticket_created_date,
    ticket_resolved_date,

    CASE
        WHEN resolution_time_hours IS NOT NULL AND ticket_resolved_date IS NOT NULL
        THEN TRUE ELSE FALSE
    END AS is_resolved,

    CASE
        WHEN customer_satisfaction_score >= 4 THEN 'satisfied'
        WHEN customer_satisfaction_score >= 3 THEN 'neutral'
        WHEN customer_satisfaction_score IS NOT NULL THEN 'unsatisfied'
        ELSE 'unknown'
    END AS satisfaction_band

FROM enriched
    );
  
  
