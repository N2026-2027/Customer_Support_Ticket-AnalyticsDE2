  create view "support"."main_staging"."stg_tickets_200k__dbt_tmp" as (
    

with raw_source as (
    -- Traemos todo tal cual viene de la fuente
    select * from "support"."raw"."customer_support_tickets"
)

select
    -- IDs (Usamos comillas solo para nombres con espacios que dbt puso en la tabla)
    cast("Ticket ID" as varchar) as ticket_id,
    md5(cast(coalesce(cast("Customer Name" as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast("Customer Email" as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) as customer_id,
    lower(trim("Customer Name")) as customer_name,
    lower(trim("Customer Email")) as customer_email,
    lower(trim("Customer Gender")) as customer_gender,
    cast("Customer Age" as integer) as customer_age,
    
    -- Dimensiones (Aquí DuckDB las ve en minúscula o snake_case)
    -- Quitamos el prefijo 'raw_source.' y las comillas para que el motor las encuentre solas
    lower(trim(product)) as product_purchased,
    lower(trim(product)) as product,
    
    lower(trim(category)) as ticket_type,
    lower(trim(category)) as category,
    
    lower(trim(status)) as ticket_status,
    lower(trim(status)) as status,
    
    lower(trim(priority)) as ticket_priority,
    lower(trim(priority)) as priority,
    
    lower(trim(channel)) as ticket_channel,
    "Ticket Subject" as ticket_subject,
    
    -- Métricas y Fechas (Usamos comillas porque el CSV de 200k tiene nombres largos con espacios)
    cast("Customer Satisfaction Score" as double) as satisfaction_rating,
    cast("Customer Satisfaction Score" as double) as customer_satisfaction_score,
    cast("First Response Time Hours" as double) as first_response_hrs,
    cast("First Response Time Hours" as double) as first_response_time_hours,
    cast("Resolution Time Hours" as double) as resolution_hrs,
    cast("Resolution Time Hours" as double) as resolution_time_hours,
    cast("Ticket Created Date" as date) as ticket_created_date,
    cast("Ticket Created Date" as date) as purchase_date,
    
    '200k' as dataset_source,
    _ingested_at

from raw_source
  );

