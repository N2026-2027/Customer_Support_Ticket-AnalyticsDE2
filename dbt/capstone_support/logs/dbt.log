  create view "support_200k"."main"."stg_tickets__dbt_tmp" as (
    

with raw_source as (
    select * from "support_200k"."main"."customer_support_tickets_200k"
)

select
    -- IDs
    md5(cast(coalesce(cast(raw_source.customer_name as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(raw_source.customer_email as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT))                                                           as customer_id,
    cast(raw_source.ticket_id as varchar)                         as ticket_id,

    -- Customer
    lower(trim(raw_source.customer_name))                         as customer_name,
    lower(trim(raw_source.customer_email))                        as customer_email,
    lower(trim(raw_source.customer_gender))                       as customer_gender,
    try_cast(raw_source.customer_age as integer)                  as customer_age,

    -- ... (tus campos NULL se mantienen igual) ...

    -- Dimensiones comunes (Ajustadas a nombres sin espacios)
    lower(trim(raw_source.product_purchased))                     as product,
    lower(trim(raw_source.ticket_type))                           as ticket_type,
    lower(trim(raw_source.ticket_subject))                        as ticket_subject,
    lower(trim(raw_source.ticket_priority))                       as ticket_priority,
    lower(trim(raw_source.ticket_status))                         as ticket_status,
    -- NOTA: Si el error persiste en channel, revisa si es 'channel' o 'ticket_channel'
    lower(trim(raw_source.ticket_channel))                        as ticket_channel, 

    -- Fechas y Timestamps
    try_cast(raw_source.date_of_purchase as date)                 as ticket_created_date,

    case
        when raw_source.first_response_time is null then null
        else epoch(try_cast(raw_source.first_response_time as timestamp)) / 3600.0
    end                                                             as first_response_hours,

    case
        when raw_source.time_to_resolution is null then null
        else epoch(try_cast(raw_source.time_to_resolution as timestamp)) / 3600.0
    end                                                             as resolution_time_hours,

    try_cast(raw_source.customer_satisfaction_rating as double)   as satisfaction_rating,

    -- Flags
    (lower(trim(raw_source.ticket_status)) = 'open'
     and raw_source.first_response_time is null)                  as is_open_no_response,
    (lower(trim(raw_source.ticket_status)) not in ('closed','resolved')) as is_unresolved,

    current_timestamp                                               as _ingested_at,
    'original'                                                      as dataset_source

from raw_source
  );

