  create view "support"."main_staging"."stg_tickets__dbt_tmp" as (
    

-- ============================================================
-- stg_tickets — Dataset original (18,762 filas / 17 columnas)
-- Headers del CSV original: Title Case con espacios
--   "Ticket ID", "Customer Name", "Customer Email", "Customer Age",
--   "Customer Gender", "Product Purchased", "Date of Purchase",
--   "Ticket Type", "Ticket Subject", "Ticket Status",
--   "Ticket Priority", "Ticket Channel",
--   "Customer Satisfaction Rating",
--   "First Response Time"  ← timestamp (2023-06-01 02:01:23)
--   "Time to Resolution"   ← timestamp (2023-06-01 02:01:23)
--
-- FIXES aplicados:
--   1. try_cast en Customer Age (hay filas con texto corrupto)
--   2. try_cast en Customer Satisfaction Rating (hay timestamps mezclados)
--   3. epoch(try_cast(... as timestamp))/3600 para los campos de tiempo
--      que vienen como string "YYYY-MM-DD HH:MM:SS"
--   4. NULL explícito para columnas que no existen en este dataset
--      pero sí en 200k (is_open_no_response, is_unresolved, etc.)
-- ============================================================

with raw_source as (
    select * from "support"."main"."customer_support_tickets"
)

select
    -- IDs
    md5(cast(coalesce(cast(raw_source."Customer Name" as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(raw_source."Customer Email" as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT))                                                           as customer_id,
    cast(raw_source."Ticket ID" as varchar)                         as ticket_id,

    -- Customer
    lower(trim(raw_source."Customer Name"))                         as customer_name,
    lower(trim(raw_source."Customer Email"))                        as customer_email,
    lower(trim(raw_source."Customer Gender"))                       as customer_gender,
    -- FIX: try_cast — hay filas con texto en este campo
    try_cast(raw_source."Customer Age" as integer)                  as customer_age,

    -- Campos exclusivos 200k → NULL para mantener schema uniforme
    cast(null as varchar)                                           as subscription_type,
    cast(null as integer)                                           as customer_tenure_months,
    cast(null as integer)                                           as previous_tickets,
    cast(null as varchar)                                           as customer_segment,
    cast(null as varchar)                                           as region,
    cast(null as varchar)                                           as operating_system,
    cast(null as varchar)                                           as browser,
    cast(null as varchar)                                           as payment_method,
    cast(null as varchar)                                           as language,
    cast(null as varchar)                                           as preferred_contact_time,
    cast(null as integer)                                           as issue_complexity_score,
    cast(null as boolean)                                           as escalated,
    cast(null as boolean)                                           as sla_breached,
    cast(null as date)                                              as ticket_resolved_date,

    -- Dimensiones comunes
    lower(trim(raw_source."Product Purchased"))                     as product,
    lower(trim(raw_source."Product Purchased"))                     as product_purchased,
    lower(trim(raw_source."Ticket Type"))                           as ticket_type,
    lower(trim(raw_source."Ticket Type"))                           as category,
    lower(trim(raw_source."Ticket Subject"))                        as ticket_subject,
    lower(trim(raw_source."Ticket Priority"))                       as ticket_priority,
    lower(trim(raw_source."Ticket Priority"))                       as priority,
    lower(trim(raw_source."Ticket Status"))                         as ticket_status,
    lower(trim(raw_source."Ticket Status"))                         as status,
    lower(trim(raw_source."Ticket Channel"))                        as ticket_channel,

    -- Fechas
    try_cast(raw_source."Date of Purchase" as date)                 as ticket_created_date,
    try_cast(raw_source."Date of Purchase" as date)                 as purchase_date,

    -- FIX: "First Response Time" viene como timestamp string, NO double
    -- epoch() convierte timestamp a segundos Unix → /3600 = horas
    case
        when raw_source."First Response Time" is null then null
        else epoch(try_cast(raw_source."First Response Time" as timestamp)) / 3600.0
    end                                                             as first_response_hours,
    case
        when raw_source."First Response Time" is null then null
        else epoch(try_cast(raw_source."First Response Time" as timestamp)) / 3600.0
    end                                                             as first_response_time_hours,

    -- FIX: igual para "Time to Resolution"
    case
        when raw_source."Time to Resolution" is null then null
        else epoch(try_cast(raw_source."Time to Resolution" as timestamp)) / 3600.0
    end                                                             as resolution_time_hours,

    -- FIX: try_cast — hay timestamps mezclados en esta columna
    try_cast(raw_source."Customer Satisfaction Rating" as double)   as satisfaction_rating,
    try_cast(raw_source."Customer Satisfaction Rating" as double)   as customer_satisfaction_score,

    -- Flags de negocio
    (lower(trim(raw_source."Ticket Status")) = 'open'
     and raw_source."First Response Time" is null)                  as is_open_no_response,
    (lower(trim(raw_source."Ticket Status")) not in ('closed','resolved')) as is_unresolved,

    -- Metadata
    current_timestamp                                               as _ingested_at,
    'original'                                                      as dataset_source

from raw_source
  );

