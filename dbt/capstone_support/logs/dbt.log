    create  table
      "support_200k"."main"."base_fact_tickets__dbt_tmp"
  
    as (
      

WITH source_data AS (
    SELECT * FROM "support_200k"."main"."stg_tickets_200k"
)

SELECT
    -- Identificadores
    CAST(ticket_id AS VARCHAR)                    AS ticket_id,
    CAST(customer_id AS VARCHAR)                  AS customer_id,
    CAST(customer_email AS VARCHAR)               AS customer_email,

    -- Información del Ticket
    CAST(ticket_channel AS VARCHAR)               AS ticket_channel,
    CAST(ticket_channel AS VARCHAR)               AS channel,
    CAST(ticket_type AS VARCHAR)                  AS category,
    CAST(ticket_subject AS VARCHAR)               AS ticket_subject,
    CAST(ticket_priority AS VARCHAR)              AS priority,
    CAST(ticket_status AS VARCHAR)                AS status,

    -- Información del Cliente y Producto
    CAST(customer_age AS INTEGER)                 AS customer_age,
    CAST(product_purchased AS VARCHAR)            AS product,
    CAST(product_purchased AS VARCHAR)            AS product_purchased,

    -- Fechas (Crucial para los modelos particionados)
    CAST(ticket_created_date AS TIMESTAMP)        AS ticket_created_date,
    CAST(purchase_date AS DATE)                   AS purchase_date,
    
    -- Métricas Numéricas (Crucial para promedios y SLAs)
    CAST(first_response_time_hours AS DOUBLE)     AS first_response_time_hours,
    CAST(resolution_time_hours AS DOUBLE)         AS resolution_time_hours,
    CAST(satisfaction_rating AS INTEGER)          AS customer_satisfaction_score,
    
    -- Metadatos
    CAST(dataset_source AS VARCHAR)               AS dataset_source,
    CAST(current_timestamp AS TIMESTAMP)          AS _ingested_at

FROM source_data
    );
  
  
