  create view "support"."main_staging"."stg_tickets__dbt_tmp" as (
    

with raw_source as (
    select * from "support"."raw"."customer_support_tickets"
)

select
    -- IDs y Claves
    md5(cast(coalesce(cast(raw_source."Customer Name" as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(raw_source."Customer Email" as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) as customer_id,
    cast(raw_source."Ticket ID" as varchar) as ticket_id,
    
    -- Información de Cliente (RESTAURADA)
