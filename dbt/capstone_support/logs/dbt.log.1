  create view "support"."main_staging"."stg_tickets_original__dbt_tmp" as (
    

with raw_source as (
    select * from "support"."main_raw"."customer_support_tickets"
)

select
    md5(cast(coalesce(cast("Customer Name" as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast("Customer Email" as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) as customer_id,
    cast("Ticket ID" as varchar) as ticket_id,
    lower(trim("Customer Name")) as customer_name,
    lower(trim("Customer Email")) as customer_email,
    lower(trim("Customer Gender")) as customer_gender,
    cast("Customer Age" as integer) as customer_age,
    
    -- Mapeo para Marts
    lower(trim("Product Purchased")) as product,
    lower(trim("Product Purchased")) as product_purchased,
    lower(trim("Ticket Type")) as category,
    lower(trim("Ticket Type")) as ticket_type,
    lower(trim("Ticket Subject")) as ticket_subject,
    lower(trim("Ticket Priority")) as priority,
    lower(trim("Ticket Priority")) as ticket_priority,
    lower(trim("Ticket Status")) as status,
    lower(trim("Ticket Status")) as ticket_status,
    lower(trim("Ticket Channel")) as ticket_channel,
    
    -- Lógica de negocio preservada
    cast("Date of Purchase" as date) as ticket_created_date,
    cast("Date of Purchase" as date) as purchase_date,
    epoch(cast("First Response Time" as timestamp)) / 3600.0 as first_response_hrs,
    epoch(cast("First Response Time" as timestamp)) / 3600.0 as first_response_time_hours,
    epoch(cast("Time to Resolution" as timestamp)) / 3600.0 as resolution_hrs,
    epoch(cast("Time to Resolution" as timestamp)) / 3600.0 as resolution_time_hours,
    
    cast("Customer Satisfaction Rating" as double) as satisfaction_rating,
    cast("Customer Satisfaction Rating" as double) as customer_satisfaction_score,
    (lower(trim("Ticket Status")) = 'open' and "First Response Time" is null) as is_open_no_response,
    (lower(trim("Ticket Status")) != 'resolved') as is_unresolved,
    
    'original' as dataset_source,
    -- CAMBIO AQUÍ: Generamos la fecha actual porque el CSV del seed no trae esta columna
    current_timestamp as _ingested_at

from raw_source
  );

[0m15:44:03.569415 [debug] [Thread-1 (]: Using duckdb connection "model.customer_support_tickets.dim_date"
[0m15:44:03.571510 [debug] [Thread-1 (]: On model.customer_support_tickets.dim_date: /* {"app": "dbt", "dbt_version": "1.11.8", "profile_name": "customer_support_tickets", "target_name": "dev", "node_id": "model.customer_support_tickets.dim_date"} */

  
    
    

    create  table
      "support"."main_marts"."dim_date__dbt_tmp"
  
    as (
      

WITH date_series AS (
    SELECT CAST(range AS DATE) AS date_day
    FROM range(DATE '2020-01-01', DATE '2026-12-31', INTERVAL 1 DAY)
)

SELECT
    date_day AS date_id,
    EXTRACT(YEAR FROM date_day) AS year,
    EXTRACT(MONTH FROM date_day) AS month,
    EXTRACT(QUARTER FROM date_day) AS quarter,
    -- strftime es el equivalente a FORMAT_DATE en DuckDB
    strftime(date_day, '%B') AS month_name,
    CASE WHEN EXTRACT(DOW FROM date_day) IN (0, 6) THEN TRUE ELSE FALSE END AS is_weekend
FROM date_series
    );
  
  
