  create view "support"."main_staging"."stg_tickets__dbt_tmp" as (
    

-- ============================================================
-- stg_tickets — Dataset original (18,762 filas / 17 columnas)
-- Headers del CSV original: Title Case con espacios
--   "Ticket ID", "Customer Name", "Customer Email", "Customer Age",
--   "Customer Gender", "Product Purchased", "Date of Purchase",
--   "Ticket Type", "Ticket Subject", "Ticket Status",
--   "Ticket Priority", "Ticket Channel",
--   "Customer Satisfaction Rating",
--   "First Response Time"  ← timestamp (2023-06-01 02:01:23)
--   "Time to Resolution"   ← timestamp (2023-06-01 02:01:23)
--
-- FIXES aplicados:
--   1. try_cast en Customer Age (hay filas con texto corrupto)
--   2. try_cast en Customer Satisfaction Rating (hay timestamps mezclados)
--   3. epoch(try_cast(... as timestamp))/3600 para los campos de tiempo
--      que vienen como string "YYYY-MM-DD HH:MM:SS"
--   4. NULL explícito para columnas que no existen en este dataset
--      pero sí en 200k (is_open_no_response, is_unresolved, etc.)
-- ============================================================

with raw_source as (
    select * from "support"."main"."customer_support_tickets"
)

select
    -- IDs
    md5(cast(coalesce(cast(raw_source."Customer Name" as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(raw_source."Customer Email" as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT))                                                           as customer_id,
    cast(raw_source."Ticket ID" as varchar)                         as ticket_id,

    -- Customer
    lower(trim(raw_source."Customer Name"))                         as customer_name,
    lower(trim(raw_source."Customer Email"))                        as customer_email,
    lower(trim(raw_source."Customer Gender"))                       as customer_gender,
    -- FIX: try_cast — hay filas con texto en este campo
    try_cast(raw_source."Customer Age" as integer)                  as customer_age,

    -- Campos exclusivos 200k → NULL para mantener schema uniforme
    cast(null as varchar)                                           as subscription_type,
    cast(null as integer)                                           as customer_tenure_months,
    cast(null as integer)                                           as previous_tickets,
    cast(null as varchar)                                           as customer_segment,
    cast(null as varchar)                                           as region,
    cast(null as varchar)                                           as operating_system,
    cast(null as varchar)                                           as browser,
    cast(null as varchar)                                           as payment_method,
    cast(null as varchar)                                           as language,
    cast(null as varchar)                                           as preferred_contact_time,
    cast(null as integer)                                           as issue_complexity_score,
    cast(null as boolean)                                           as escalated,
    cast(null as boolean)                                           as sla_breached,
    cast(null as date)                                              as ticket_resolved_date,

    -- Dimensiones comunes
    lower(trim(raw_source."Product Purchased"))                     as product,
    lower(trim(raw_source."Product Purchased"))                     as product_purchased,
    lower(trim(raw_source."Ticket Type"))                           as ticket_type,
    lower(trim(raw_source."Ticket Type"))                           as category,
    lower(trim(raw_source."Ticket Subject"))                        as ticket_subject,
    lower(trim(raw_source."Ticket Priority"))                       as ticket_priority,
    lower(trim(raw_source."Ticket Priority"))                       as priority,
    lower(trim(raw_source."Ticket Status"))                         as ticket_status,
    lower(trim(raw_source."Ticket Status"))                         as status,
    lower(trim(raw_source."Ticket Channel"))                        as ticket_channel,

    -- Fechas
    try_cast(raw_source."Date of Purchase" as date)                 as ticket_created_date,
    try_cast(raw_source."Date of Purchase" as date)                 as purchase_date,

    -- FIX: "First Response Time" viene como timestamp string, NO double
    -- epoch() convierte timestamp a segundos Unix → /3600 = horas
    case
        when raw_source."First Response Time" is null then null
        else epoch(try_cast(raw_source."First Response Time" as timestamp)) / 3600.0
    end                                                             as first_response_hours,
    case
        when raw_source."First Response Time" is null then null
        else epoch(try_cast(raw_source."First Response Time" as timestamp)) / 3600.0
    end                                                             as first_response_time_hours,

    -- FIX: igual para "Time to Resolution"
    case
        when raw_source."Time to Resolution" is null then null
        else epoch(try_cast(raw_source."Time to Resolution" as timestamp)) / 3600.0
    end                                                             as resolution_time_hours,

    -- FIX: try_cast — hay timestamps mezclados en esta columna
    try_cast(raw_source."Customer Satisfaction Rating" as double)   as satisfaction_rating,
    try_cast(raw_source."Customer Satisfaction Rating" as double)   as customer_satisfaction_score,

    -- Flags de negocio
    (lower(trim(raw_source."Ticket Status")) = 'open'
     and raw_source."First Response Time" is null)                  as is_open_no_response,
    (lower(trim(raw_source."Ticket Status")) not in ('closed','resolved')) as is_unresolved,

    -- Metadata
    current_timestamp                                               as _ingested_at,
    'original'                                                      as dataset_source

from raw_source
  );

[0m18:14:03.842554 [debug] [Thread-3 (]: On model.customer_support_tickets.stg_tickets_200k: /* {"app": "dbt", "dbt_version": "1.11.8", "profile_name": "customer_support_tickets", "target_name": "dev", "node_id": "model.customer_support_tickets.stg_tickets_200k"} */

  
  create view "support"."main_staging"."stg_tickets_200k__dbt_tmp" as (
    

-- ============================================================
-- COLUMNAS REALES del CSV 200k (snake_case nativo):
--   ticket_id, customer_name, customer_email, product, category,
--   priority, status, channel, region, customer_age, customer_gender,
--   subscription_type, customer_tenure_months, previous_tickets,
--   customer_satisfaction_score, first_response_time_hours,
--   resolution_time_hours, ticket_created_date, ticket_resolved_date,
--   escalated, sla_breached, operating_system, browser,
--   payment_method, language, preferred_contact_time,
--   issue_complexity_score, customer_segment
--
-- NO usar "Ticket ID" con comillas/Title Case — eso es el dataset
-- original (18k). Spark preserva los headers del CSV tal cual.
-- ============================================================

with source as (
    select * from "support"."main"."customer_support_tickets_200k"
),

renamed as (
    select
        -- IDs
        cast(ticket_id as varchar)                              as ticket_id,

        md5(cast(coalesce(cast(customer_name as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(customer_email as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT))                                                   as customer_id,

        -- Customer
        nullif(lower(trim(customer_name)),   '')                as customer_name,
        nullif(lower(trim(customer_email)),  '')                as customer_email,
        nullif(lower(trim(customer_gender)), '')                as customer_gender,
        try_cast(customer_age as integer)                       as customer_age,

        -- Campos exclusivos del 200k
        nullif(lower(trim(subscription_type)),  '')             as subscription_type,
        try_cast(customer_tenure_months as integer)             as customer_tenure_months,
        try_cast(previous_tickets as integer)                   as previous_tickets,
        nullif(lower(trim(customer_segment)), '')               as customer_segment,
        nullif(lower(trim(region)),    '')                      as region,
        nullif(lower(trim(operating_system)), '')               as operating_system,
        nullif(lower(trim(browser)),   '')                      as browser,
        nullif(lower(trim(payment_method)),   '')               as payment_method,
        nullif(lower(trim(language)),  '')                      as language,
        nullif(lower(trim(preferred_contact_time)), '')         as preferred_contact_time,
        try_cast(issue_complexity_score as integer)             as issue_complexity_score,
        try_cast(escalated    as boolean)                       as escalated,
        try_cast(sla_breached as boolean)                       as sla_breached,
        try_cast(ticket_resolved_date as date)                  as ticket_resolved_date,

        -- Dimensiones comunes (normalizadas + alias para marts)
        nullif(lower(trim(product)),   '')                      as product,
        nullif(lower(trim(product)),   '')                      as product_purchased,
        nullif(lower(trim(category)),  '')                      as ticket_type,
        nullif(lower(trim(category)),  '')                      as category,
        nullif(lower(trim(status)),    '')                      as ticket_status,
        nullif(lower(trim(status)),    '')                      as status,
        nullif(lower(trim(priority)),  '')                      as ticket_priority,
        nullif(lower(trim(priority)),  '')                      as priority,
        nullif(lower(trim(channel)),   '')                      as ticket_channel,

        -- Métricas — ya vienen como números, NO timestamps
        try_cast(customer_satisfaction_score as double)         as satisfaction_rating,
        try_cast(customer_satisfaction_score as double)         as customer_satisfaction_score,
        try_cast(first_response_time_hours as double)           as first_response_hours,
        try_cast(first_response_time_hours as double)           as first_response_time_hours,
        try_cast(resolution_time_hours as double)               as resolution_time_hours,

        -- Flags de negocio
        (lower(trim(status)) = 'open')                          as is_open_no_response,
        (lower(trim(status)) not in ('closed','resolved'))      as is_unresolved,

        -- Fechas
        try_cast(ticket_created_date as date)                   as ticket_created_date,
        try_cast(ticket_created_date as date)                   as purchase_date,

        -- Metadata
        current_timestamp                                       as _ingested_at,
        '200k'                                                  as dataset_source

    from source
),

deduplicated as (
    select *,
        row_number() over (
            partition by ticket_id
            order by _ingested_at desc
        ) as _rn
    from renamed
)

-- Columnas explícitas: nunca SELECT * para evitar que _rn (INTEGER)
-- se propague al UNION ALL de base_fact_tickets
select
    ticket_id,
    customer_id,
    customer_name,
    customer_email,
    customer_gender,
    customer_age,
    subscription_type,
    customer_tenure_months,
    previous_tickets,
    customer_segment,
    region,
    operating_system,
    browser,
    payment_method,
    language,
    preferred_contact_time,
    issue_complexity_score,
    escalated,
    sla_breached,
    ticket_resolved_date,
    product,
    product_purchased,
    ticket_type,
    category,
    ticket_status,
    status,
    ticket_priority,
    priority,
    ticket_channel,
    satisfaction_rating,
    customer_satisfaction_score,
    first_response_hours,
    first_response_time_hours,
    resolution_time_hours,
    is_open_no_response,
    is_unresolved,
    ticket_created_date,
    purchase_date,
    _ingested_at,
    dataset_source
from deduplicated
where _rn = 1
  );

