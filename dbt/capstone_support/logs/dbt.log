-- CTE 1: Traemos los datos crudos con los nombres originales de la fuente
with raw_source as (
    select
        ticket_id,
        customer_id,
        customer_email,
        customer_age,
        ticket_channel,
        ticket_type,
        ticket_subject,
        ticket_priority,
        ticket_status,
        ticket_created_date,
        purchase_date,
        product_purchased,
        first_response_time_hours,
        resolution_time_hours,
        satisfaction_rating
    from "support_200k"."main"."stg_tickets_200k"
),

-- CTE 2: Aplicamos CAST y COALESCE usando los nombres de la CTE anterior
final_formatted as (
    select
        -- Identificadores
        cast(ticket_id as varchar) as ticket_id,
        cast(customer_id as varchar) as customer_id,
        lower(trim(cast(customer_email as varchar))) as customer_email,

        -- Dimensiones y sus Alias (Definidos aquí, NO se referencian entre sí)
        lower(trim(cast(ticket_channel as varchar))) as ticket_channel,
        lower(trim(cast(ticket_channel as varchar))) as channel,
        
        lower(trim(cast(ticket_type as varchar))) as ticket_type,
        lower(trim(cast(ticket_type as varchar))) as category,
        
        coalesce(cast(ticket_subject as varchar), '(sin asunto)') as ticket_subject,
        
        lower(trim(cast(ticket_priority as varchar))) as ticket_priority,
        lower(trim(cast(ticket_priority as varchar))) as priority,
        
        lower(trim(cast(ticket_status as varchar))) as ticket_status,
        lower(trim(cast(ticket_status as varchar))) as status,

        -- Cliente y Producto
        coalesce(cast(customer_age as integer), 0) as customer_age,
        lower(trim(cast(product_purchased as varchar))) as product,
        lower(trim(cast(product_purchased as varchar))) as product_purchased,

        -- Fechas y Métricas
        cast(ticket_created_date as timestamp) as ticket_created_at,
        cast(ticket_created_date as timestamp) as ticket_created_date,
        cast(purchase_date as date) as purchase_date,
        
        coalesce(cast(first_response_time_hours as double), 0.0) as first_response_time_hours,
        coalesce(cast(resolution_time_hours as double), 0.0) as resolution_time_hours,
        coalesce(cast(satisfaction_rating as integer), 0) as satisfaction_rating,
        coalesce(cast(satisfaction_rating as integer), 0) as customer_satisfaction_score,
        
        -- Metadatos
        '200k' as dataset_source,
        current_timestamp as _ingested_at
    from raw_source
)

-- SELECT FINAL: Ya no hay lógica, solo mostramos lo que ya se definió arriba
select * from final_formatted
    );
  
  
