  create view "support_200k"."main"."stg_tickets__dbt_tmp" as (
    

with raw_source as (
    select * from "support_200k"."main"."customer_support_tickets_200k"
)

select
    cast("Ticket ID" as varchar) as ticket_id,
    "Customer Name" as customer_name,
    "Customer Email" as customer_email,
    "Customer Gender" as customer_gender,
    "Customer Age"::integer as customer_age,
    
    "Product Purchased" as product,
    "Product Purchased" as product_purchased,
    "Ticket Type" as ticket_type,
    "Ticket Priority" as ticket_priority,
    "Ticket Status" as ticket_status,
    "Ticket Channel" as ticket_channel,
    "Ticket Subject" as ticket_subject,
    
    "Customer Satisfaction Rating"::double as satisfaction_rating,
    "Date of Purchase"::date as ticket_created_date,
    
    'original' as dataset_source,
    current_timestamp as _ingested_at
from raw_source
  );

[0m17:19:01.014814 [debug] [Thread-2 (]: Opening a new connection, currently in state closed
[0m17:19:01.024085 [debug] [Thread-2 (]: SQL status: OK in 0.009 seconds
[0m17:19:01.024584 [debug] [Thread-2 (]: Using duckdb connection "model.customer_support_tickets.mart_customer_risk_v2"
[0m17:19:01.018912 [debug] [Thread-1 (]: Writing injected SQL for node "model.customer_support_tickets.dim_date"
