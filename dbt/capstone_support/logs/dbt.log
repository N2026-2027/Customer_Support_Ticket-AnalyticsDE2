with tickets as (
    select * from "support_200k"."main"."base_fact_tickets"
),

dates as (
    select * from "support_200k"."main"."dim_date"
)

select
    t.*,
    -- CORRECCIÓN: Usamos 'month' que es la columna real en dim_date
    d.month as month_name, 
    d.quarter,
    d.year as fiscal_year
from tickets t
left join dates d 
    on cast(t.ticket_created_date as date) = d.date_day
    );
  
  
