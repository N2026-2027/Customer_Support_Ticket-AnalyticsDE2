  create view "support_200k"."main_staging"."stg_tickets__dbt_tmp" as (
    

with src as (
    -- dbt-duckdb adjunta la base como 'support_original' segun tu YAML
    select * from "support_original"."main"."customer_support_tickets"
)

select
    -- Usamos el alias del CTE para que DuckDB no busque en el catálogo equivocado
    cast(src."Ticket ID" as varchar) as ticket_id,
    md5(cast(coalesce(cast(src."Customer Name" as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(src."Customer Email" as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) as customer_id,
    
    lower(trim(src."Product Purchased")) as product,
    lower(trim(src."Ticket Channel")) as ticket_channel,
    lower(trim(src."Ticket Type")) as ticket_type,
    lower(trim(src."Ticket Status")) as ticket_status,
    lower(trim(src."Ticket Priority")) as ticket_priority,
    
    cast(src."Customer Satisfaction Rating" as double) as satisfaction_rating,
    cast(src."Date of Purchase" as date) as ticket_created_date,
    
    current_timestamp as _ingested_at,
    'original' as dataset_source
from src
  );

